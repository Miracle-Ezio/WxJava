.plan-page {
  background: #FFFFFF;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ── 封面 ──────────────────────── */
.plan-cover {
  padding: 96rpx 48rpx 64rpx;
  background: linear-gradient(180deg, #FAF9F6 0%, #FFFFFF 100%);
  text-align: center;
  border-bottom: 1rpx solid #ECECEC;
}

.plan-cover__mono {
  font-family: "Times New Roman", serif;
  font-size: 96rpx;
  letter-spacing: -8rpx;
  color: #0A0A0A;
  margin-bottom: 24rpx;
}

.plan-cover__title {
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.plan-cover__sub {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  margin-bottom: 48rpx;
}

.plan-cover__meta {
  display: flex;
  justify-content: space-around;
  padding-top: 32rpx;
  border-top: 1rpx solid #ECECEC;
}
.meta-item__label {
  font-size: 22rpx;
  color: #B8B8B8;
  margin-bottom: 8rpx;
}
.meta-item__value {
  font-size: 26rpx;
  font-weight: 500;
}

/* ── 锚点 ──────────────────────── */
.anchor-bar {
  display: flex;
  white-space: nowrap;
  padding: 24rpx 32rpx;
  position: sticky;
  top: 0;
  background: #FFFFFF;
  border-bottom: 1rpx solid #ECECEC;
  z-index: 10;
}
.anchor {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: #8A8A8A;
  border-radius: 999rpx;
  margin-right: 16rpx;
}
.anchor--active {
  background: #0A0A0A;
  color: #FFFFFF;
}

/* ── 章节 ──────────────────────── */
.sections {
  padding: 0 32rpx;
}
.section {
  padding: 48rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.section:last-child { border-bottom: none; }

.section__type-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #8B6A3F;
  background: #E8DCC2;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}

.section__title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.section__content {
  font-size: 28rpx;
  color: #4A4A4A;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* ── 项目卡 ──────────────────────── */
.items {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.item-card {
  background: #FAF9F6;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #ECECEC;
}
.item-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.item-card__name {
  font-size: 30rpx;
  font-weight: 600;
}
.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.item-row--total {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ECECEC;
}

/* ── 底部 CTA ──────────────────────── */
.plan-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #ECECEC;
}
.plan-foot .btn { flex: 1; }
