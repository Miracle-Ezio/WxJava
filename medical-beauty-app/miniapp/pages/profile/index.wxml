<view class="page">
  <view class="profile__head">
    <image class="profile__avatar" src="{{avatarUrl || ''}}" mode="aspectFill" />
    <view class="profile__info">
      <view class="title-lg">{{nickname || '亲爱的客户'}}</view>
      <view class="level-badge level-badge--{{levelCode}}" style="margin-top: 16rpx;">{{levelLabel}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="goPlanList">
      <text>我的规划</text>
      <text class="text-muted">›</text>
    </view>
    <view class="divider"></view>
    <view class="row" bindtap="comingSoon">
      <text>消费记录</text>
      <text class="text-muted">›</text>
    </view>
    <view class="divider"></view>
    <view class="row" bindtap="comingSoon">
      <text>储值卡 / 余次</text>
      <text class="text-muted">›</text>
    </view>
    <view class="divider"></view>
    <view class="row" bindtap="comingSoon">
      <text>电子合同</text>
      <text class="text-muted">›</text>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="comingSoon">
      <text>隐私设置</text>
      <text class="text-muted">›</text>
    </view>
    <view class="divider"></view>
    <view class="row" bindtap="onLogout">
      <text style="color: #B05656;">退出登录</text>
    </view>
  </view>
</view>
