.page {
  padding-bottom: 200rpx;
}

/* ── 步骤条 ──────────────────────── */
.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 48rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.step__num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #B8B8B8;
  background: #FFFFFF;
  border: 1rpx solid #D8D8D8;
  border-radius: 50%;
}
.step--active .step__num {
  color: #FFFFFF;
  background: #0A0A0A;
  border-color: #0A0A0A;
}
.step__label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #B8B8B8;
  letter-spacing: 1rpx;
}
.step--active .step__label {
  color: #0A0A0A;
}
.step__line {
  flex: 1;
  height: 1rpx;
  background: #ECECEC;
  margin: 0 8rpx;
  margin-bottom: 24rpx;
}
.step__line--active { background: #0A0A0A; }

.section-title {
  margin: 16rpx 0 24rpx;
}

/* ── 项目卡 ──────────────────────── */
.proj-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(10, 10, 10, 0.04);
}
.proj-card--active {
  border-color: #0A0A0A;
}
.proj-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.proj-card__name {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* ── 日期 ──────────────────────── */
.date-bar {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 0 24rpx;
}
.date-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(10, 10, 10, 0.04);
}
.date-cell--active {
  background: #0A0A0A;
  border-color: #0A0A0A;
}
.date-cell--active .date-cell__week,
.date-cell--active .date-cell__day,
.date-cell--active .date-cell__month {
  color: #FFFFFF;
}
.date-cell__week {
  font-size: 22rpx;
  color: #8A8A8A;
  letter-spacing: 1rpx;
}
.date-cell__day {
  font-family: "Times New Roman", serif;
  font-size: 48rpx;
  font-weight: 600;
  margin: 8rpx 0;
}
.date-cell__month {
  font-size: 20rpx;
  color: #B8B8B8;
}

/* ── 时段 ──────────────────────── */
.hours-hint {
  font-size: 22rpx;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}
.slot-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.slot {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 26rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 1rpx solid #ECECEC;
}
.slot--disabled {
  color: #D8D8D8;
  background: #F5F5F5;
  border-color: #F5F5F5;
  text-decoration: line-through;
}
.slot--active {
  color: #FFFFFF;
  background: #0A0A0A;
  border-color: #0A0A0A;
}

/* ── 确认 ──────────────────────── */
.confirm-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
}
.note-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background: #FAF9F6;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.tips {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #FAF9F6;
  border-left: 4rpx solid #C8A96A;
  font-size: 22rpx;
  color: #8A8A8A;
  line-height: 1.8;
}

/* ── 底部固定按钮 ──────────────────────── */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #ECECEC;
}
.footer .btn { flex: 1; }
