.home__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 40rpx;
}

.reminder__label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.reminder__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0A0A0A;
  margin-bottom: 12rpx;
}
.reminder__desc {
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.reminder__action {
  display: flex;
  justify-content: flex-end;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 48rpx 8rpx 24rpx;
}

.plan-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(10, 10, 10, 0.04);
}

.plan-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.plan-card__sub {
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.plan-card__progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.progress__bar {
  flex: 1;
  height: 8rpx;
  background: #ECECEC;
  border-radius: 4rpx;
  overflow: hidden;
}
.progress__fill {
  height: 100%;
  background: linear-gradient(90deg, #D8BC82, #B8995A);
  border-radius: 4rpx;
}

.plan-card__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #ECECEC;
}
