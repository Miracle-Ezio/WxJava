<view class="page">

  <view class="header">
    <view>
      <view class="title-xl">照片对比</view>
      <view class="text-secondary" style="margin-top: 8rpx;">见证每一次蜕变</view>
    </view>
    <view class="add-btn" bindtap="goUpload">+ 拍照</view>
  </view>

  <!-- 机位筛选 -->
  <scroll-view class="pose-bar" scroll-x scroll-with-animation>
    <view
      class="pose-chip {{poseFilter === null ? 'pose-chip--active' : ''}}"
      bindtap="onPoseFilter"
      data-code=""
    >全部</view>
    <view
      class="pose-chip {{poseFilter === item.code ? 'pose-chip--active' : ''}}"
      wx:for="{{poses}}"
      wx:key="code"
      bindtap="onPoseFilter"
      data-code="{{item.code}}"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 同机位快捷对比卡 -->
  <view wx:if="{{quickCompare && quickCompare.before && quickCompare.after}}" class="card card--accent quick">
    <view class="text-accent" style="font-size: 22rpx; letter-spacing: 2rpx;">同机位 · 首张 vs 最新</view>
    <view class="quick__row">
      <view class="quick__photo">
        <image class="quick__img" src="{{quickCompare.before.url}}" mode="aspectFill" />
        <view class="quick__label">{{formatDate(quickCompare.before.shotAt)}}</view>
      </view>
      <view class="quick__arrow">→</view>
      <view class="quick__photo">
        <image class="quick__img" src="{{quickCompare.after.url}}" mode="aspectFill" />
        <view class="quick__label">{{formatDate(quickCompare.after.shotAt)}}</view>
      </view>
    </view>
    <view class="quick__action">
      <button
        class="btn btn--gold"
        size="mini"
        data-before="{{quickCompare.before.id}}"
        data-after="{{quickCompare.after.id}}"
        bindtap="goCompare"
      >滑动对比 ›</button>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <!-- 时间轴 -->
  <block wx:elif="{{timeline.length}}">
    <view class="month-block" wx:for="{{timeline}}" wx:key="month" wx:for-item="mg">
      <view class="month-label">{{mg.month}}</view>
      <view class="grid">
        <view
          class="grid-item"
          wx:for="{{mg.photos}}"
          wx:for-item="p"
          wx:key="id"
          data-id="{{p.id}}"
          bindtap="onPhotoTap"
          bindlongpress="onPhotoLongPress"
        >
          <image class="grid-img" src="{{p.url}}" mode="aspectFill" />
          <view class="grid-tag">{{p.poseLabel}}</view>
          <view wx:if="{{p.locked}}" class="grid-lock">🔒</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <view>还没有照片</view>
    <view class="text-muted" style="margin-top: 16rpx; font-size: 22rpx;">
      点击右上角"+ 拍照"开始你的对比之旅
    </view>
  </view>

  <view class="privacy-note">
    您的照片仅您本人与授权顾问可见 · 私密加密存储
  </view>
</view>

<wxs module="formatDate">
  module.exports = function(s) {
    if (!s) return '';
    // s 可能是 ISO 字符串 / 数组 / 对象，统一截取前 10 位
    var str = '' + s;
    return str.slice(5, 10);
  }
</wxs>
