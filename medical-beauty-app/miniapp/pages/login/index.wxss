.login {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 200rpx 64rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login__brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.login__monogram {
  font-family: "Times New Roman", "Songti SC", serif;
  font-size: 160rpx;
  font-weight: 400;
  letter-spacing: -16rpx;
  color: #0A0A0A;
  line-height: 1;
  margin-bottom: 32rpx;
}

.login__title {
  font-family: "Times New Roman", serif;
  font-size: 56rpx;
  font-weight: 400;
  letter-spacing: 12rpx;
  color: #0A0A0A;
}

.login__zh {
  font-size: 32rpx;
  letter-spacing: 16rpx;
  color: #2A2A2A;
  margin-top: 16rpx;
}

.login__tagline {
  margin-top: 56rpx;
  font-size: 24rpx;
  color: #B8B8B8;
  letter-spacing: 4rpx;
}

.login__tagline-en {
  font-size: 18rpx;
  color: #D8D8D8;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.login__welcome {
  text-align: center;
  margin-bottom: 96rpx;
}

.login__actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login__btn {
  width: 100%;
  max-width: 520rpx;
}

.login__protocol {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #B8B8B8;
}
